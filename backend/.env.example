# BillBook Backend Environment Variables (.env)
# Copy this file to .env

# Supabase Postgres Configuration (Phase 2)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Internal API Authentication (shared with mobile apiClient)
API_KEY=your-secure-internal-api-key

# Google Gemini API Configuration (Phase 3 & 6)
# Keep this key strictly on the backend; never expose to mobile client
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
