# BillBook Backend Environment Variables (.env)
# Copy this file to .env

# Database Configuration (Supabase Postgres or local PostgreSQL)
# Example Supabase direct connection string:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Example local docker connection:
DATABASE_URL=postgresql://quiz_arena:quiz_arena@localhost:5432/billbook

# Supabase Credentials (optional / metadata)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Internal API Authentication (checked via X-API-Key header on all endpoints except /health)
API_KEY=billbook-secret-dev-key

# Application Settings
FLASK_ENV=development
PORT=5000

# Google Gemini API Configuration (Phase 3 & 6)
# Keep this key strictly on the backend; never expose to mobile client
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
