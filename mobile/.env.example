# BillBook Mobile Environment Variables (.env)
# Copy this file to .env or .env.local

# URL of the hosted or local Flask backend (Phase 2 & 4)
# When testing on real device via Expo Go, replace localhost with LAN IP or ngrok/deployed URL
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Use mock data service (true) or live Flask API (false)
# Phase 1 uses true (AsyncStorage mock)
# Phase 4 switches to false (live API)
EXPO_PUBLIC_USE_MOCK=true
