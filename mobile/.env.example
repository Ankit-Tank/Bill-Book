# BillBook mobile/web environment (copy to .env)
# These EXPO_PUBLIC_* values are bundled into the app, so never put secret keys here.

# Base URL of the Flask API.
#   Android emulator:   http://10.0.2.2:5000/api/v1
#   Real phone (Expo Go): http://<your-computer-LAN-IP>:5000/api/v1
#   Production / web build: your HTTPS backend, e.g. https://api.example.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Must match API_KEY in backend/.env. For a public web build, add real user login before sharing the link.
EXPO_PUBLIC_API_KEY=change-me

# true  = run on built-in sample data (no backend needed, for UI work)
# false = use the live Flask + Postgres backend
EXPO_PUBLIC_USE_MOCK=false
