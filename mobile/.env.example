# BillBook Mobile Environment Variables (.env)
# Copy this file to .env or .env.local

# URL of the hosted Flask backend over HTTPS
EXPO_PUBLIC_API_URL=https://powerful-giving-labeled-advances.trycloudflare.com/api/v1

# Internal API authentication key
EXPO_PUBLIC_API_KEY=billbook-secret-dev-key

# Use mock data service (true) or live Flask API (false)
# Phase 1 uses true (AsyncStorage mock)
# Phase 4 switches to false (Live Supabase API)
EXPO_PUBLIC_USE_MOCK=false
